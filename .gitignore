DerivedData/
.DS_Store
*.xcuserstate
# Xcode 工作区级用户本地状态（窗口布局等），不进版本库
AIEnglishApp.xcodeproj/project.xcworkspace/xcuserdata/
supabase/.temp/

# 每个 worktree 各自维护本地端口（如端口相撞时改这里）；CI 与全新检出
# 由 scripts/ci/test-database.sh 从 config.toml.example 自动复制。
supabase/config.toml

# 编辑器 / 工具的本地状态，不该进版本库
.obsidian/
**/.obsidian/
.playwright-mcp/

# 机器本地的 Claude Code 设置。
# ⚠️ 绝不提交：这个文件的 permissions.allow 里会留下带密钥的历史命令。
.claude/settings.local.json

# Superpowers visual-companion mockups (local only)
.superpowers/

# 本地密钥文件（如 GEMINI_API_KEY），绝不提交
supabase/.env.local
supabase/functions/.env.local

# 本工作树内 xcodebuild 的派生数据（模拟器测试用）
.build-test/

# 外部工具克隆（独立 git 仓库，不随本仓库走）
enable-chrome-ai/

# Supabase CLI 误入函数目录的本地状态（linked-project / cli 缓存）
supabase/functions/reconcile-orphan-images/supabase/

# Supabase CLI 的本地分支快照产物
supabase/.branches/
